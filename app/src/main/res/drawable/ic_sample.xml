<?xml version="1.0" encoding="utf-8"?>
<!--
    A simple vector drawable stored in res/drawable/.

    Why vector instead of PNG?
      • Scales perfectly to any screen density (no blurring)
      • Small file size
      • Defined in XML — easy to edit

    This is referenced in code as:  R.drawable.ic_sample
    And in XML as:                  android:src="@drawable/ic_sample"
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- A simple star shape -->
    <path
        android:fillColor="#FFFFB300"
        android:pathData="M12,17.27L18.18,21l-1.64,-7.03L22,9.24l-7.19,-0.61L12,2 9.19,8.63 2,9.24l5.46,4.73L5.82,21z" />
</vector>
