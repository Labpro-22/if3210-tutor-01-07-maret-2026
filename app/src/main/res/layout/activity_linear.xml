<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════╗
    ║         LINEAR LAYOUT DEMO           ║
    ╚══════════════════════════════════════╝

    LinearLayout: places children in a single line.
      • orientation="vertical"   → top to bottom (most common)
      • orientation="horizontal" → left to right

    Key attributes:
      layout_weight — lets a child "take up" proportional space.
      gravity       — aligns the content *inside* a view.
      layout_gravity — aligns the view *within* its parent.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vertical LinearLayout"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- These three colored boxes stack top-to-bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FF6200EE"
        android:layout_marginBottom="4dp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FF03DAC5"
        android:layout_marginBottom="4dp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFB300" />

    <!-- ───────── Horizontal strip ───────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Horizontal LinearLayout (with weight)"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <!--
        Nested horizontal LinearLayout.
        layout_weight distributes the remaining space proportionally:
          red   weight=1 → gets 1/4 of the width
          green weight=2 → gets 2/4
          blue  weight=1 → gets 1/4
        Set layout_width="0dp" so that weight governs the size entirely.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FFE53935" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:background="#FF43A047" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#FF1E88E5" />

    </LinearLayout>

</LinearLayout>
