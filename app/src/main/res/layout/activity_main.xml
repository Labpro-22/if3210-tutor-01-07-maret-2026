<?xml version="1.0" encoding="utf-8"?>
<!--
    Uses @dimen/ references so that all spacing/sizes come from dimens.xml.
    Try changing a value in dimens.xml and see it update everywhere.
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- ── Section title ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title_resources"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/section_spacing" />

        <!-- ══════════════════════════════════════
             DRAWABLE RESOURCE
             R.drawable.ic_sample → res/drawable/ic_sample.xml
             ══════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_image_section"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!--
            android:src="@drawable/ic_sample" sets the image in XML.
            We also set it in code with setImageResource(R.drawable.ic_sample)
            to show both ways.
        -->
        <ImageView
            android:id="@+id/ivStar"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:src="@drawable/ic_sample"
            android:contentDescription="@string/desc_star"
            android:layout_marginTop="@dimen/item_spacing"
            android:layout_marginBottom="@dimen/section_spacing" />

        <!-- ══════════════════════════════════════
             STRING RESOURCE
             R.string.msg_string_resource → strings.xml
             ══════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_string_section"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!-- Text is set from code via getString(R.string.msg_string_resource) -->
        <TextView
            android:id="@+id/tvStringDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:background="#FFF3E0"
            android:padding="@dimen/item_spacing"
            android:layout_marginTop="@dimen/item_spacing"
            android:layout_marginBottom="@dimen/section_spacing" />

        <!-- ══════════════════════════════════════
             DIMEN RESOURCE
             R.dimen.screen_padding → dimens.xml
             ══════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_dimen_section"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <!-- Text is set in code to show the dimen value in px -->
        <TextView
            android:id="@+id/tvDimenDemo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_body"
            android:background="#E8F5E9"
            android:padding="@dimen/item_spacing"
            android:layout_marginTop="@dimen/item_spacing"
            android:layout_marginBottom="@dimen/section_spacing" />

        <!--
            This view uses @dimen values for padding AND textSize directly in XML,
            demonstrating that dimens.xml can be used anywhere a size is needed.
        -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_padded_text"
            android:padding="@dimen/screen_padding"
            android:textSize="@dimen/text_body"
            android:background="#E3F2FD" />

    </LinearLayout>
</ScrollView>
